{
  "permissions": {
    "allow": [
      "Bash(pytest:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make fmt)",
      "Bash(rambass check:*)",
      "Bash(rambass status:*)",
      "Bash(rambass doctor:*)",
      "Bash(rambass stale:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "defaultMode": "acceptEdits",
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  }
}
