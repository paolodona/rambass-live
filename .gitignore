# ── Audio & video media never goes in git ────────────────────────────────
# Source recordings, stems, renders and videos are large and binary.
# Keep them on disk / in the band's cloud drive; git tracks the *recipes*.
*.wav
*.aif
*.aiff
*.flac
*.mp3
*.m4a
*.ogg
*.opus
*.mp4
*.mov
*.mkv
*.webm
*.avi

# Images: the photos behind the band, and the generated title cards. Both are
# rebuildable or live in the band's shared drive; docs/video.md says where.
*.png
*.jpg
*.jpeg
*.gif
*.webp

# Reaper working files (the generated .RPP under reaper/build is disposable,
# the project you actually save while editing is yours and stays local)
*.RPP-bak
*.rpp-bak
*.reapeaks
reaper/build/*.rbs
songs/**/reaper/

# Generated subtitle files. The tracked source is lyrics.srt at the song root;
# everything under video/ is rebuilt from it and from song.yaml.
songs/**/video/*.ass

# Demucs / model caches
.cache/
models/
*.ckpt
*.pt
*.pth
*.th

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# OS
.DS_Store
._*
Thumbs.db

# Local overrides
rambass.local.toml
.env

# Hand-run drum MIDI experiments. The pipeline's own variants are
# drums-{raw,quantized,consolidated,restored}.mid and those ARE tracked; anything
# else under midi/ is a one-off from a debugging session. Ignored rather than just
# untracked because `git add -A` swept these back in twice: -16ths is Manlio
# quantised to the wrong grid (it is a shuffle), which is an actively misleading
# file to leave sitting beside the real ones.
songs/*/*/midi/drums-*-16ths.mid
songs/*/*/midi/drums-*-prepasses.mid

# Backups a forced rebuild writes. `review.rebuild_song` copies an artifact to
# <name>.bak before --force overwrites it, which is the right bargain -- but the
# copy is not a deliverable, and render/click.wav.bak is not caught by *.wav.
songs/**/*.bak
